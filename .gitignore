# Generated pipeline artifacts (regenerable: latency logs, plots, processed npz)
data/processed/*.csv
data/processed/*.png
data/processed/*.npz
data/processed/*.json
!data/processed/.gitkeep
# ...except the filter/sensitivity benchmark summary:
!data/processed/benchmarks_02092026/filter_bench.summary.json

# Environment / secrets
.env
.env.*
!.env.example

# LaTeX build directories
docs/**/build/

# Generated PDFs in docs build
docs/**/*.pdf
!docs/figures/*.pdf
!docs/presentation/*.pdf

# Generated PDFs in dist
dist/**/*.pdf
!dist/main.pdf
!dist/v1.5/main.pdf

# Raw proprietary Motive session files (>200MB, not usable without Motive license)
*.tak

