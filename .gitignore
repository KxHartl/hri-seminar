# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*.log
~$*

# Python
__pycache__/
*.pyc
.venv/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
*.nav
